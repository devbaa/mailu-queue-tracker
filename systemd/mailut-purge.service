[Unit]
Description=Mailu Tools retention purge (delete expired audit records)
Documentation=man:mailut(8)
After=mailut-audit.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mailut audit purge --expired --yes
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
StateDirectory=mailut
StateDirectoryMode=0700
RuntimeDirectory=mailut
RuntimeDirectoryMode=0755

NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
